@page
@using Microsoft.Extensions.Options
@using Swashbuckle.AspNetCore.SwaggerUI
@using Web
@using Web.Controllers
@inject IOptions<SwaggerUIOptions> SwaggerUi
@inject Resources Resources
@{
    ViewData["Title"] = "{home}";
}
<ul>
    <li>
        <span>{openapi}</span>
        <ul>
            <li>
                <a href="@Url.Content($"~/{SwaggerUi.Value.RoutePrefix}")">{ui}</a>
            </li>
            <li>
                <a asp-route="@nameof(OpenApiController.GetJson)">{json}</a>
            </li>
            <li>
                <a asp-route="@nameof(OpenApiController.GetYaml)">{yaml}</a>
            </li>
        </ul>
    </li>
    <li>
        <span>{endpoints}</span>
        <ul>
            @foreach (var endpoint in Resources.Manifest.Endpoints)
            {
                <li>
                    <a href="@endpoint.Path">@endpoint.Path</a>
                </li>
            }
        </ul>
    </li>
</ul>
