<!--
  Build-time validation of named query definitions.

  NuGet imports files from the package's build/ folder only into projects that reference
  TheODI.NamedQuery directly, so apps that get the package through a library are not validated.
-->
<Project>

  <!-- Validate only runnable apps: skip libraries, test projects and IDE design-time builds. -->
  <PropertyGroup>
    <_NamedQueryValidate Condition="('$(OutputType)' == 'Exe' Or '$(OutputType)' == 'WinExe') And '$(IsTestProject)' != 'true' And '$(DesignTimeBuild)' != 'true'">true</_NamedQueryValidate>
  </PropertyGroup>

  <!--
    After the app is built, run it once with the library's startup hook loaded.
    The hook starts the host with a no-op server, validates the configured definitions against all
    of the app's endpoints, prints any problems as MSBuild-format errors and stops the app.
  -->
  <Target Name="_NamedQueryValidateDefinitions" AfterTargets="Build" Condition="'$(_NamedQueryValidate)' == 'true'">
    <!-- Startup hooks are disabled (for example by trimming), so the hook could not load and the app would start for real. -->
    <Warning Condition="'$(StartupHookSupport)' == 'false'" Code="NQ0003" Text="Named query definitions are not validated because StartupHookSupport is false." />

    <PropertyGroup Condition="'$(StartupHookSupport)' != 'false'">
      <!-- Use the dotnet host running this build, falling back to the one on PATH. -->
      <_NamedQueryDotnet>$(DOTNET_HOST_PATH)</_NamedQueryDotnet>
      <_NamedQueryDotnet Condition="'$(_NamedQueryDotnet)' == ''">dotnet</_NamedQueryDotnet>
      <!-- The hook is loaded by simple assembly name, so the app's own copy of the library is used. NAMEDQUERY_VALIDATION activates it and lets apps skip side effects. -->
      <_NamedQueryEnvironment>DOTNET_STARTUP_HOOKS=TheODI.NamedQuery;NAMEDQUERY_VALIDATION=1</_NamedQueryEnvironment>
    </PropertyGroup>

    <!--
      Exec turns the app's "path(line,col) : error NQxxxx : message" lines into build errors, which fail the build.
      The working directory matches dotnet run, so the app finds its appsettings.
    -->
    <Exec Condition="'$(StartupHookSupport)' != 'false'" Command="&quot;$(_NamedQueryDotnet)&quot; &quot;$(TargetPath)&quot;" WorkingDirectory="$(MSBuildProjectDirectory)" EnvironmentVariables="$(_NamedQueryEnvironment)" />
  </Target>

</Project>
