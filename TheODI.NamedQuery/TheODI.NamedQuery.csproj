<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IsPackable>true</IsPackable>
    <Version>0.0.0-dev</Version>
    <Description>Serves SPARQL queries described in an RDF manifest as named HTTP endpoints for ASP.NET Core, with content negotiation, OpenAPI and MCP.</Description>
    <PackageTags>sparql;rdf;linked-data;named-query;openapi;mcp;aspnetcore</PackageTags>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotNetRdf.Core" />
    <PackageReference Include="langsamu.dotNetRdf.Wrapping" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test" />
    <InternalsVisibleTo Include="ValidateResources" />
  </ItemGroup>

</Project>
