<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IsPackable>true</IsPackable>
    <Version>0.0.0-dev</Version>
    <Description>Serves SPARQL queries described in an RDF manifest as named HTTP endpoints for ASP.NET Core, with content negotiation, OpenAPI and MCP.</Description>
    <PackageTags>sparql;rdf;linked-data;named-query;openapi;mcp;aspnetcore</PackageTags>
    <PackageProjectUrl>https://github.com/theodi/NamedQuery</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <EnablePackageValidation>true</EnablePackageValidation>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackNamedQueryValidator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="dotNetRdf.Core" />
    <PackageReference Include="dotNetRdf.Shacl" />
    <PackageReference Include="langsamu.dotNetRdf.Wrapping" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Validation\shapes.ttl" LogicalName="TheODI.NamedQuery.Validation.shapes.ttl" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Test" />
    <InternalsVisibleTo Include="TheODI.NamedQuery.Validator" />
  </ItemGroup>

  <Target Name="_PackNamedQueryValidator">
    <PropertyGroup>
      <_NamedQueryValidatorProject>$(MSBuildThisFileDirectory)..\TheODI.NamedQuery.Validator\TheODI.NamedQuery.Validator.csproj</_NamedQueryValidatorProject>
    </PropertyGroup>

    <MSBuild Projects="$(_NamedQueryValidatorProject)" Targets="Restore" Properties="_NamedQueryValidatorRestore=true" />
    <MSBuild Projects="$(_NamedQueryValidatorProject)" Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="_NamedQueryValidatorOutput" />
    </MSBuild>

    <ItemGroup>
      <_NamedQueryValidatorFile Include="@(_NamedQueryValidatorOutput->'%(RootDir)%(Directory)%(Filename).dll');@(_NamedQueryValidatorOutput->'%(RootDir)%(Directory)%(Filename).pdb');@(_NamedQueryValidatorOutput->'%(RootDir)%(Directory)THIRD-PARTY-NOTICES.txt')" />
      <TfmSpecificPackageFile Include="@(_NamedQueryValidatorFile)" PackagePath="tools\validator\" />
    </ItemGroup>
  </Target>

</Project>

