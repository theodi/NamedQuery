{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../TheODI.NamedQuery",
          "files": [
            "TheODI.NamedQuery.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "NoWarn": "NU1902"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "api/**.yml",
          "api/index.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "context7.json"
        ]
      }
    ],
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "TheODI.NamedQuery",
      "_enableSearch": true,
      "_appFooter": "<script src='https://context7.com/widget.js' data-library='/theodi/namedquery'></script>"
    },
    "output": "_site"
  }
}
