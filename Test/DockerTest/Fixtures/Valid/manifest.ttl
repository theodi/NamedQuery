PREFIX : <http://example.org/namedquery/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

[
    :name "Docker test" ;
    :endpoint
        [
            :path "docker-test" ;
            :sparql "./queries/docker-test.sparql"^^xsd:anyURI ;
            :name "Docker test" ;
            :description "Asks whether the Docker test resource exists." ;
        ] ;
] .
