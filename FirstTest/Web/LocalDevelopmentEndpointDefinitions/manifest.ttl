PREFIX : <http://example.org/namedquery/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

[
    :path "endpoint1" ;
    :sparql "./endpoint1.sparql"^^xsd:anyURI ;
] .

[
    :path "endpoint2" ;
    :sparql "./endpoint2.sparql"^^xsd:anyURI ;
] .

[
    :path "endpoint3/something" ;
    :sparql "./endpoint3.sparql"^^xsd:anyURI ;
] .

[
    :path "endpoint4" ;
    :sparql "./endpoint4.sparql"^^xsd:anyURI ;
] .

[
    :path "endpoint5" ;
    :sparql "./endpoint5.sparql"^^xsd:anyURI ;
    :frame "./endpoint5.jsonld"^^xsd:anyURI ;
] .

[
    :path "endpoint6" ;
    :sparql "./endpoint6.sparql"^^xsd:anyURI ;
    :parameter [
        :name "value" ;
    ] ;
] .
